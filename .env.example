# Copiez ce fichier vers .env.local puis remplissez les valeurs.

# --- Supabase -----------------------------------------------------------------
# Tableau de bord → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# Clé service_role : elle contourne RLS. Serveur uniquement, jamais NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Session ------------------------------------------------------------------
# Clé de signature des cookies. Générez-la avec : openssl rand -base64 32
AUTH_SECRET=""

# --- URL publique -------------------------------------------------------------
# Sert de "relying party" WebAuthn : les passkeys sont liées à ce domaine exact.
# En local, gardez http://localhost:3000 (les passkeys y sont autorisées).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Notifications push (optionnel) -------------------------------------------
# Générez la paire avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:vous@exemple.fr"

# --- Cron (optionnel) ---------------------------------------------------------
# Protège /api/cron/reminders. Laissez vide en local pour pouvoir l'appeler.
CRON_SECRET=""
